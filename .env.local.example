# ---------------------------------------------------------------------------
# Brain
# ---------------------------------------------------------------------------
# Where the Scout backend (scout/) is listening. The cockpit probes this;
# unreachable just means it runs in SIM mode.
SCOUT_API_URL=http://localhost:8000
SCOUT_AGENT_ID=scout

# The observation log — every captured fact and every handover decision, as
# JSONL. Facts and trust are rebuilt from it on boot, so deleting this file
# forgets everything the interns learned.
# BRAIN_LOG_PATH=.data/brain.jsonl

# Set to 0 on a read-only filesystem. Everything still works; nothing survives
# a restart.
# BRAIN_PERSIST=1

# ---------------------------------------------------------------------------
# Outbox safety
# ---------------------------------------------------------------------------
# 1 = run the whole approve → send path but stop short of the network. The UI
# and the MCP tools say DRY RUN so nobody mistakes it for a real send.
# Worth leaving on until you've watched a few drafts go through.
OUTBOX_DRY_RUN=1

# ---------------------------------------------------------------------------
# Gmail + Calendar — installed-app OAuth, sends as the authorised person
# ---------------------------------------------------------------------------
# Create an OAuth client (type: Desktop) in Google Cloud Console, then mint a
# refresh token once with these scopes:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/calendar.events
# A service account will not work for Gmail — sending as a person needs that
# person's grant.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Optional. Sets the From header; defaults to the authorised account.
# GOOGLE_SENDER=Andrew Wang <andrew@example.com>

# Optional. Which calendar events land on.
# GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Slack — writing lives here, behind the approval gate
# ---------------------------------------------------------------------------
# Bot token needs chat:write (plus chat:write.public to post somewhere the bot
# hasn't been invited). Scout's own Slack provider stays read-only.
# SLACK_BOT_TOKEN=xoxb-***

# ---------------------------------------------------------------------------
# Webhook — escape hatch for anything Intern doesn't speak natively
# ---------------------------------------------------------------------------
# Approved actions POST here when no native connector is configured for that
# kind. Point it at your own mailer, a queue, or VoiceOS.
# OUTBOX_WEBHOOK_URL=
# OUTBOX_WEBHOOK_SECRET=
